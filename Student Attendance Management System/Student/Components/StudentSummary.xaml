<UserControl x:Class="Student_Attendance_Management_System.Student.Components.StudentSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Student_Attendance_Management_System.Student.Components"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="680">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border CornerRadius="10"
                Background="White"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Total Present"
                           Foreground="{DynamicResource DefaultDarkGray}"
                           FontSize="15"
                           FontWeight="Medium" />
                <TextBlock Text="0"
                           x:Name="totalPresentText"
                           Grid.Row="2"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource DefaultDarkGray}"
                           FontSize="24"/>
            </Grid>
        </Border>
        <Border CornerRadius="10"
                Background="White"
                Grid.Column="2"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
            </Border.Effect>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Total Absent"
                           Foreground="{DynamicResource DefaultDarkGray}"
                           FontSize="15"
                           FontWeight="Medium" />
                <TextBlock Text="0"
                           x:Name="totalAbsentText"
                           Grid.Row="2"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource DefaultDarkGray}"
                           FontSize="24" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
