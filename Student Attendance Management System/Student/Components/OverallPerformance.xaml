<UserControl x:Class="Student_Attendance_Management_System.Student.Components.OverallPerformance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Student_Attendance_Management_System.Student.Components" xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="182.5" d:DesignWidth="300">
    <Grid>
        <lvc:Gauge Uses360Mode="True"
           Grid.Column="2"
           x:Name="performancePercentage"
           GaugeBackground="{DynamicResource DefaultLightGray}"
           FromColor="{DynamicResource SecondaryColor}"
           ToColor="{DynamicResource BlackColor}"
           From="10" To="100" Value="0">
            <lvc:Gauge.GaugeRenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="160" />
                    <ScaleTransform ScaleX="1" />
                </TransformGroup>
            </lvc:Gauge.GaugeRenderTransform>
        </lvc:Gauge>
    </Grid>
</UserControl>
