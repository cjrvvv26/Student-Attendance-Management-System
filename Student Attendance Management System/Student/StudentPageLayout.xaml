<Window x:Class="Student_Attendance_Management_System.Student.StudentPageLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Student_Attendance_Management_System.Student"
        xmlns:components="clr-namespace:Student_Attendance_Management_System.Student.Components" xmlns:models="clr-namespace:Student_Attendance_Management_System.Models" d:DataContext="{d:DesignInstance Type=models:StudentModel}"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Title="StudentLayout" Height="720" Width="1280">
    <Border Background="White" CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--Side Navigation-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="PresenTrack" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <!--Side Nav-->
                <Grid Grid.Row="2" Margin="0 0 0 20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Click="Dashboard_Click">Dashboard</Button>
                        <Button Grid.Row="1" Click="Profile_Click">Profile</Button>
                        <Button Grid.Row="2" Click="Classes_Click">Class</Button>
                        <Button Grid.Row="3" Click="Notifications_Click">Notification</Button>
                    </Grid>
                    <Button Grid.Row="2" Height="50" Click="LogOut_Click" Content="Logout" />
                </Grid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!--Header-->
                <Grid VerticalAlignment="Center" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Full_name}" 
                                   Foreground="{DynamicResource DefaultDarkGray}"
                                   FontSize="15"
                                   Width="200"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Role}"
                                   Foreground="{DynamicResource DefaultGray}"
                                   FontSize="12"
                                   Grid.Row="2"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   FontWeight="Medium"/>
                    </Grid>
                </Grid>
                <!--Content-->
                <Frame Name="StudentLayout" Grid.Row="2" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Border>
</Window>
