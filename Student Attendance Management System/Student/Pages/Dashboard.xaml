<Page x:Class="Student_Attendance_Management_System.Student.Pages.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.Student.Pages"
      xmlns:data="clr-namespace:Student_Attendance_Management_System.Student.Components"
      mc:Ignorable="d" 
       xmlns:fa="http://schemas.fontawesome.io/icons/"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
              
              HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20 10 20 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="summaryReport" />
            <!--2nd row-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--List of today's class-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--Summary of Reports-->
                    <!--Top Report Summary-->
                    <Grid x:Name="studentSummary" />
                    <Border CornerRadius="10"
                            Padding="20"
                            Grid.Row="2"
                            Background="White">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
                        </Border.Effect>
                        <!--Classes Today-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--Header-->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="On Session Class" 
                                            Foreground="{DynamicResource DefaultDarkGray}"
                                            FontWeight="Medium"
                                            FontSize="15"
                                            />
                                <Button Foreground="{DynamicResource DefaultGray}"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Click="ViewMoreClass_Click"
                                        Grid.Column="2"
                                        Template="{DynamicResource RemovePrimaryTrigger}"
                                        Background="Transparent"
                                        Content="View More" />
                            </Grid>
                            <!--Content-->
                            <Grid x:Name="classListBox" Grid.Row="2"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--Notification's Box-->
                    <Border CornerRadius="10"
                            Background="White">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
                        </Border.Effect>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource DefaultDarkGray}"
                                           FontSize="15"
                                           FontWeight="Medium"
                                           Text="Notifications" />
                                <Button Foreground="{DynamicResource DefaultGray}"
                                        FontSize="12"
                                        Click="ViewMoreNotif_Click"
                                        FontWeight="Medium"
                                        Grid.Column="2"
                                        Template="{DynamicResource RemovePrimaryTrigger}"
                                        Background="Transparent"
                                        Content="View More" />
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Hidden"
                                          Height="192.5"
                                            Grid.Row="2" >
                                <Grid x:Name="unreadNotificationBox" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" CornerRadius="10"
                            Background="White">
                        <Grid  Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Foreground="{DynamicResource DefaultDarkGray}"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Text="Your Performance" />
                            <Grid Grid.Row="1" x:Name="yourPerformance" Margin="0,10,0,0" Grid.RowSpan="2" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
