<Page x:Class="Student_Attendance_Management_System.Student.Pages.Classes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.Student.Pages"
      mc:Ignorable="d" 
       xmlns:fa="http://schemas.fontawesome.io/icons/"
      xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel"
      d:DataContext="{d:DesignInstance Type=viewmodel:ClassesVM}"
      d:DesignHeight="491" d:DesignWidth="1040"
      Title="Classes">

    <Grid Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  x:Name="classSectionDisplay"
          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0 0 0 10">
                <!-- Today's Class Available -->
                <TextBlock Text="Today's Class"
               Foreground="{DynamicResource DefaultPrimary}"
               FontSize="15"
               FontWeight="Medium"
               Margin="0 0 0 10"/>

                <DataGrid Style="{DynamicResource DefaultDataGrid}"
                      x:Name="todayClassTable"
                      ItemsSource="{Binding StudentAvailableClasses}"
                      CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                      RowStyle="{DynamicResource LastestRowStyle}"
                      ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}"
                      CanUserSortColumns="False"
                      AutoGenerateColumns="False"
                      MinHeight="150"
                      MaxHeight="300"
                      Margin="0 0 0 30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Class ID" Width="*" Binding="{Binding Class_id}" />
                        <DataGridTextColumn Header="Subject Name" Width="*" Binding="{Binding Subject_name}" />
                        <DataGridTextColumn Header="Course" Width="*" Binding="{Binding Course}" />
                        <DataGridTextColumn Header="Year &amp; Section" Width="*" Binding="{Binding Year_section}" />
                        <DataGridTextColumn Header="Scheduled Day" Width="*" Binding="{Binding Schedule_day}" />
                        <DataGridTextColumn Header="Scheduled Time" Width="*" Binding="{Binding Schedule_time}" />
                        <DataGridTemplateColumn Header="Operations" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="ViewClassStatus_Click"
                                Height="45"
                                Padding="15 0"
                                Template="{DynamicResource RemovePrimaryTrigger}"
                                Background="#00C951"
                                Tag="{Binding}">
                                        <fa:ImageAwesome Icon="Eye"
                                             Width="20"
                                             Height="20"
                                             Foreground="White"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No Classes Today"
                       Foreground="{DynamicResource DefaultGray}"
                       FontSize="13"
                       FontWeight="Medium"
                       x:Name="noTodayClassText"
                       Margin="0 50 0 0"
                       Height="100"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
                <!-- Teacher's All Classes -->
                <TextBlock Text="All Class"
               Foreground="{DynamicResource DefaultPrimary}"
               FontSize="15"
               FontWeight="Medium"
               Margin="0 0 0 10"/>

                <DataGrid Style="{DynamicResource DefaultDataGrid}"
                      CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                      RowStyle="{DynamicResource LastestRowStyle}"
                      ItemsSource="{Binding StudentAvailableClasses}"
                      ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}"
                      CanUserSortColumns="False"
                      x:Name="displayAllClass"
                      AutoGenerateColumns="False"
                      MinHeight="200"
                      MaxHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Class ID" Width="*" Binding="{Binding Class_id}" />
                        <DataGridTextColumn Header="Subject Name" Width="*" Binding="{Binding Subject_name}" />
                        <DataGridTextColumn Header="Course" Width="*" Binding="{Binding Course}" />
                        <DataGridTextColumn Header="Year &amp; Section" Width="*" Binding="{Binding Year_section}" />
                        <DataGridTextColumn Header="Scheduled Day" Width="*" Binding="{Binding Schedule_day}" />
                        <DataGridTextColumn Header="Scheduled Time" Width="*" Binding="{Binding Schedule_time}" />
                        <DataGridTemplateColumn Header="Operations" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="ViewClassStatus_Click"
                                Height="45"
                                Padding="15 0"
                                Template="{DynamicResource RemovePrimaryTrigger}"
                                Background="#00C951"
                                Tag="{Binding}">
                                        <fa:ImageAwesome Icon="ClockOutline"
                                             Width="20"
                                             Height="20"
                                             Foreground="White"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Text="No Assigned Class"
               Foreground="{DynamicResource DefaultGray}"
               FontSize="13"
               FontWeight="Medium"
               x:Name="noClassText"
               Visibility="Collapsed"
               Margin="0 100 0 0"
               VerticalAlignment="Center"
               HorizontalAlignment="Center" />
    </Grid>
</Page>
