<Page x:Class="Student_Attendance_Management_System.Teacher.Pages.OverallRecord"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.Teacher.Pages"
      xmlns:vm="clr-namespace:Student_Attendance_Management_System.ViewModel" xmlns:fa="http://schemas.fontawesome.io/icons/"
      d:DataContext="{d:DesignInstance Type=vm:AttendanceVM}"
      mc:Ignorable="d" 
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="OverallRecord">

    <Grid Margin="20 10 20 20"
      Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Attendance Details-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <!--Top Ribbon-->
                <Grid Height="24" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Template="{DynamicResource TopRibbonGray}"
                            FontSize="12"
                            Click="ViewAllClass_Click"
                            Foreground="{DynamicResource DefaultGray}"
                            FontWeight="Medium"
                            Background="Transparent"
                            Content="View Classes" RenderTransformOrigin="0.71,0.68" />
                    <fa:ImageAwesome Grid.Column="2" 
                                     Icon="ChevronRight" 
                                     Width="8" Height="8"
                                     Foreground="{DynamicResource DefaultGray}"/>
                    <Button Template="{DynamicResource TopRibbonGray}" 
                            Grid.Column="4"
                            FontSize="12"
                            Foreground="{DynamicResource DefaultPrimary}"
                            FontWeight="Medium"
                            Background="Transparent"
                            Content="View Class Information" />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="pdfBtn" 
                            Padding="15 0"
                            Height="50"
                            Click="pdfBtn_Click"
                            HorizontalAlignment="Left"
                            Foreground="White"
                            Background="{DynamicResource DefaultPrimary}"
                            Template="{DynamicResource RemovePrimaryTrigger}"
                            Content="Generate PDF"/>
                    <ComboBox x:Name="termFilterCombo"
                              Template="{DynamicResource InputComboBox}"
                              FontSize="13"
                              Height="50"
                              Grid.Column="2"
                              SelectionChanged="TermFilterCombo_SelectionChanged"
                              Padding="15 0"
                              FontWeight="Medium"
                              VerticalContentAlignment="Center"
                              Foreground="{DynamicResource DefaultDarkGray}" />
                </Grid>
            </Grid>
        </Grid>
        <!--Lists of students-->
        <DataGrid Style="{DynamicResource DefaultDataGrid}"
                  Grid.Row="2"
                  x:Name="listStudentsTable"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  ItemsSource="{Binding GetOverallRecord}"
                  RowStyle="{DynamicResource DefaultLogRow}"
                  CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                  ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student No." Width="*" Binding="{Binding Student_number}"/>
                <DataGridTextColumn Header="Name" Width="2*" Binding="{Binding Student_name}"/>
                <DataGridTextColumn Header="Gender" Width="80" Binding="{Binding Student_gender}"/>
                <DataGridTextColumn Header="Total Present" Width="*" Binding="{Binding Total_present}"/>
                <DataGridTextColumn Header="Total Absent" Width="*" Binding="{Binding Total_absent}"/>
                <DataGridTextColumn Header="Abjusted Absent" Width="*" Binding="{Binding Abjusted_absent}"/>
                <DataGridTextColumn Header="Final Status" Width="*" Binding="{Binding Final_status}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="No Enrolled Students" 
                   VerticalAlignment="Center"
                   FontWeight="Medium"
                   FontSize="13"
                   x:Name="noStudents"
                   Visibility="Collapsed"
                   Margin="0 200 0 0"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource DefaultGray}"/>
    </Grid>
</Page>
