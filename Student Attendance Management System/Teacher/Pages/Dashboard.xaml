<Page x:Class="Student_Attendance_Management_System.Teacher.Pages.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.Teacher.Pages" xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      xmlns:component="clr-namespace:Student_Attendance_Management_System.Teacher.Components"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20 10 20 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--Summary of Reports-->
            <!--Top Report Summary-->
            <Grid x:Name="summaryReport" />
            <!--2nd row-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--List of today's class-->
                <Border CornerRadius="10"
                        Padding="20"
                        Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
                    </Border.Effect>
                    <!--Classes Today-->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--Header-->
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Today's Class" 
                                        Foreground="{DynamicResource DefaultDarkGray}"
                                        FontWeight="Medium"
                                        FontSize="15"
                                        />
                            <Button Foreground="{DynamicResource DefaultGray}"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Grid.Column="2"
                                            Template="{DynamicResource RemovePrimaryTrigger}"
                                            Background="Transparent"
                                            Content="View More" />
                        </Grid>
                        <!--Content-->
                        <Grid x:Name="classListBox" Grid.Row="2"/>
                    </Grid>
                </Border>
                <!--Notification's Box-->
                <Border CornerRadius="10"
                        Grid.Column="2"
                        Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
                    </Border.Effect>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource DefaultDarkGray}"
                               FontSize="15"
                               FontWeight="Medium"
                               Text="Notifications" />
                            <Button Foreground="{DynamicResource DefaultGray}"
                                FontSize="12"
                                FontWeight="Medium"
                                Grid.Column="2"
                                Template="{DynamicResource RemovePrimaryTrigger}"
                                Background="Transparent"
                                Content="View More" />
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Hidden"
                                      Height="359"
                                      Grid.Row="2" >
                            <Grid x:Name="unreadNotificationBox" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
