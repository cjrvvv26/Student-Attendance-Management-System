<Page x:Class="Student_Attendance_Management_System.Teacher.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.Teacher.Pages" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:models="clr-namespace:Student_Attendance_Management_System.Models" d:DataContext="{d:DesignInstance Type=models:TeacherModel}"
      mc:Ignorable="d" 
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="Profile">


    <Grid Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid VerticalAlignment="Center" Margin="0 0 0 30"
              Visibility="Collapsed"
              x:Name="topRibbonsBtn">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Template="{DynamicResource TopRibbonGray}"
                     FontSize="12"
                     Foreground="{DynamicResource DefaultGray}"
                     FontWeight="Medium"
                     Background="Transparent"
                     Content="Your Information" Click="ViewTeacherTopRibbon" RenderTransformOrigin="0.71,0.68" />
            <fa:ImageAwesome Grid.Column="2" Icon="ChevronRight"  Width="8" Height="8"
                          Foreground="{DynamicResource DefaultGray}"/>
            <Button Template="{DynamicResource TopRibbonGray}" 
                     Grid.Column="4"
                     FontSize="12"
                     Foreground="{DynamicResource DefaultPrimary}"
                     FontWeight="Medium"
                     x:Name="viewTeacherTopRibbon"
                     Background="Transparent"
                     Content="Update Information" />
            <Grid x:Name="topRibbonUpdateUser"
               Visibility="Collapsed"
               Grid.Column="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <fa:ImageAwesome Icon="ChevronRight"  Width="8" Height="8"
              Foreground="{DynamicResource DefaultGray}"/>
                <Button Template="{DynamicResource TopRibbonGray}" 
                     Grid.Column="2"
                     FontSize="12"
                     Foreground="{DynamicResource DefaultPrimary}"
                     FontWeight="Medium"
                     Background="Transparent"
                     Content="Update User Information" />
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="200" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle x:Name="profileBox" RadiusX="10" RadiusY="10">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="teacherProfile" Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Border x:Name="defaultProfileBox"
                         Visibility="Collapsed"
                         CornerRadius="10" Background="{DynamicResource DefaultLightGray}">
                    <fa:ImageAwesome Icon="User" Foreground="{DynamicResource DefaultGray}"
                      Width="120" Height="120"/>
                </Border>
                <!--Button of Update pic-->
                <Button Grid.Row="2" 
                         Visibility="Collapsed"
                         x:Name="UploadImgBtn"
                         Template="{DynamicResource RemovePrimaryTrigger}"
                         Click="UploadImgBtn_Click"
                         Background="{DynamicResource DefaultPrimary}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Image" Width="15" Height="15" Foreground="White"/>
                        <TextBlock Grid.Column="2" Text="Upload Profile" 
                        Foreground="White"
                        FontWeight="Medium"
                        FontSize="13"
                        />
                    </Grid>
                </Button>
            </Grid>
            <!--INFORMATION-->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <!--Header-->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Personal Information"
                    FontSize="18" FontWeight="Medium"
                    Foreground="{DynamicResource DefaultPrimary}"/>
                    <Button Grid.Column="2" Template="{DynamicResource IconBtnTemplate}" x:Name="editBtn" Height="20" Background="Transparent" BorderThickness="0" Click="UpdateProfile_Click">
                        <fa:ImageAwesome Icon="Pencil" Foreground="{DynamicResource DefaultGray}" />
                    </Button>
                </Grid>
                <!--Content-->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="First Name" Foreground="{DynamicResource DefaultGray}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding First_name}"
                                    Foreground="{DynamicResource DefaultDarkGray}"
                                    Grid.Row="2" TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    x:Name="fnameText"
                                    FontSize="14" FontWeight="Medium"/>
                        <TextBox Template="{DynamicResource TextBoxInput}"
                                 Foreground="{DynamicResource DefaultDarkGray}"
                                 Grid.Row="2"
                                 Padding="5 10"
                                 x:Name="fnameBox"
                                 Visibility="Collapsed"
                                Background="White"
                                 TextWrapping="NoWrap"
                                 FontSize="14" FontWeight="Medium"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Middle Name" Foreground="{DynamicResource DefaultGray}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Middle_name}"
                         x:Name="mnameText"
                        Foreground="{DynamicResource DefaultDarkGray}"
                        Grid.Row="2" TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        FontSize="14" FontWeight="Medium"/>
                        <TextBox Template="{DynamicResource TextBoxInput}"
                         Foreground="{DynamicResource DefaultDarkGray}"
                         Grid.Row="2"
                         Padding="5 10"
                         x:Name="mnameBox"
                         Visibility="Collapsed"
                         Background="White"
                         TextWrapping="NoWrap"
                         FontSize="14" FontWeight="Medium"/>
                    </Grid>
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Last Name" Foreground="{DynamicResource DefaultGray}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Last_name}"
                        Foreground="{DynamicResource DefaultDarkGray}"
                        Grid.Row="2" TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        x:Name="lnameText"
                        FontSize="14" FontWeight="Medium"/>
                        <TextBox Template="{DynamicResource TextBoxInput}"
                         Foreground="{DynamicResource DefaultDarkGray}"
                         Grid.Row="2"
                         Padding="5 10"
                         x:Name="lnameBox"
                         Visibility="Collapsed"
                         Background="White"
                         TextWrapping="NoWrap"
                         FontSize="14" FontWeight="Medium"/>
                    </Grid>
                </Grid>
                <!--3rd Row-->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Gender" Foreground="{DynamicResource DefaultGray}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Gender}"
                        Foreground="{DynamicResource DefaultDarkGray}"
                        Grid.Row="2" TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        FontSize="14" x:Name="genderText" FontWeight="Medium"/>
                        <Grid Grid.Row="2" x:Name="genderBox" Visibility="Collapsed" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="maleRadio" 
                              VerticalContentAlignment="Center"
                              Foreground="{DynamicResource DefaultDarkGray}"
                              FontWeight="Medium"
                              Content="Male" FontSize="14"/>
                            <RadioButton x:Name="femaleRadio" 
                              Grid.Column="2"
                              VerticalContentAlignment="Center"
                              Foreground="{DynamicResource DefaultDarkGray}"
                              FontWeight="Medium"
                              Content="Female" FontSize="14" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Birth Date" Foreground="{DynamicResource DefaultGray}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock x:Name="bdayText" Text="{Binding Birth_date, StringFormat='yyyy-MM-dd'}"
                                    Foreground="{DynamicResource DefaultDarkGray}"
                                    Grid.Row="2" TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    FontSize="14" FontWeight="Medium"/>
                        <DatePicker x:Name="bdayBox"
                         Foreground="{DynamicResource DefaultDarkGray}"
                         Grid.Row="2"
                         SelectedDateChanged="bdayBox_SelectedDateChanged"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         BorderThickness="0"
                         FontSize="14" FontWeight="Medium">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="IsReadOnly" Value="True"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </Grid>
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Age" Foreground="{DynamicResource DefaultGray}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Age}"
                        VerticalAlignment="Center"
                        x:Name="ageText"
                        FontSize="14"
                        Foreground="{DynamicResource DefaultDarkGray}"
                        Grid.Row="2" TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" FontWeight="Medium"/>

                    </Grid>
                </Grid>
                <!--4th Row-->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Department" x:Name="departLabel"
                        Foreground="{DynamicResource DefaultGray}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Department}"
                        x:Name="departText"
                        Foreground="{DynamicResource DefaultDarkGray}"
                        Grid.Row="2" TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        FontSize="14" FontWeight="Medium"/>
                        <ComboBox   Visibility="Collapsed"
                        x:Name="departBox"
                         Template="{DynamicResource InputComboBox}"
                        Foreground="{DynamicResource DefaultDarkGray}"
                        Grid.Row="2"
                        Padding="5 10"
                         Background="White"
                        FontSize="14" FontWeight="Medium"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Phone No." x:Name="phoneLabel" Foreground="{DynamicResource DefaultGray}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Phone_no}"
                        Foreground="{DynamicResource DefaultDarkGray}"
                        Grid.Row="2" TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        x:Name="phoneText"
                        FontSize="14" FontWeight="Medium"/>
                        <TextBox Template="{DynamicResource TextBoxInput}"
                         Foreground="{DynamicResource DefaultDarkGray}"
                         Grid.Row="2"
                         Padding="5 10"
                         x:Name="phoneBox"
                                 Text="+63"
                         Visibility="Collapsed"
                         Background="White"
                         TextWrapping="NoWrap"
                         FontSize="14" FontWeight="Medium"/>
                        <ComboBox x:Name="yearCombo" FontSize="14" 
                       Padding="5 10"
                       Visibility="Collapsed"
                       Grid.Row="2"
                       Foreground="{DynamicResource DefaultDarkGray}" 
                       Template="{DynamicResource InputComboBox}"
                       Background="{DynamicResource DefaultLightGray}"/>
                    </Grid>
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Email"
                                   Foreground="{DynamicResource DefaultGray}"
                                   FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Email}"
                                    x:Name="emailText"
                                    Foreground="{DynamicResource DefaultDarkGray}"
                                    Grid.Row="2" TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    FontSize="14" FontWeight="Medium"/>
                        <TextBox Visibility="Collapsed"
                                x:Name="emailBox"
                                Template="{DynamicResource TextBoxInput}"
                                Foreground="{DynamicResource DefaultDarkGray}"
                                Grid.Row="2"
                                Padding="5 10"
                         Background="White"
                                FontSize="14" FontWeight="Medium"/>
                    </Grid>
                </Grid>
                <!--5th Row-->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="oldPassContainer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Old Password"
                                   Foreground="{DynamicResource DefaultGray}"
                                   FontSize="13" FontWeight="Medium"/>

                        <TextBox Template="{DynamicResource TextBoxInput}"
                                 Foreground="{DynamicResource DefaultDarkGray}"
                                 Grid.Row="2"
                                 Padding="5 10"
                                 x:Name="oldPassTextBox"
                                 Visibility="Collapsed"
                                 Background="{DynamicResource DefaultLightGray}"
                                 TextWrapping="NoWrap"
                                 FontSize="14" FontWeight="Medium"/>
                        <PasswordBox Style="{DynamicResource    DefaultPasswordBoxTemplate}"
                                 Foreground="{DynamicResource DefaultDarkGray}"
                                 Grid.Row="2"
                                 Padding="5 10"
                                 x:Name="oldPassBox"
                                 Background="White"
                                 FontSize="14" FontWeight="Medium"/>
                    </Grid>
                    <Grid Grid.Column="2"
                          Visibility="Collapsed"
                          x:Name="newPassContainer">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="New Password"
                                   Foreground="{DynamicResource DefaultGray}"
                                   FontSize="13" FontWeight="Medium"/>

                        <TextBox Template="{DynamicResource TextBoxInput}"
                                 Foreground="{DynamicResource DefaultDarkGray}"
                                 Grid.Row="2"
                                 Padding="5 10"
                                 x:Name="newPassTextBox"
                                 Visibility="Collapsed"
                                 Background="{DynamicResource DefaultLightGray}"
                                 TextWrapping="NoWrap"
                                 FontSize="14" FontWeight="Medium"/>
                        <PasswordBox Style="{DynamicResource    DefaultPasswordBoxTemplate}"
                                 Foreground="{DynamicResource DefaultDarkGray}"
                                 Grid.Row="2"
                                 Padding="5 10"
                                 x:Name="newPassBox"
                                 Background="White"
                                 FontSize="14" FontWeight="Medium"/>
                    </Grid>
                </Grid>
                <!--6th Row-->
                <Grid Grid.Row="10" x:Name="UpdateBtnBox" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Template="{DynamicResource RemovePrimaryTrigger}"
                             Height="50" Width="120" 
                             FontSize="13"
                            Grid.Column="2"
                             x:Name="View"
                             FontWeight="Medium"
                             Click="View_Click"
                             Foreground="{DynamicResource DefaultGray}"
                             Background="Transparent" Content="Cancel" />
                    <Button Template="{DynamicResource RemovePrimaryTrigger}" Height="50" Width="120" Background="{DynamicResource DefaultPrimary}"
                            x:Name="ProceedUpdate"
                            Click="ProceedUpdate_Click"
                            HorizontalAlignment="Left">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Update"
                                        FontWeight="Medium"
                                        FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <fa:ImageAwesome Grid.Column="2" Foreground="white" Height="12" Width="12" Icon="ChevronRight" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
