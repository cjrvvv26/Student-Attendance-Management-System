<UserControl x:Class="Student_Attendance_Management_System.Teacher.Components.ReportSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Student_Attendance_Management_System.Teacher.Components" xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="108.5" d:DesignWidth="1040">
    <Border CornerRadius="10"
            Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:ImageAwesome Icon="Users"
                             Foreground="{DynamicResource DefaultDarkGray}"
                             VerticalAlignment="Top"
                             Height="20" Width="20"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Total Students"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultDarkGray}"/>
                    <TextBlock Text="0"
                               HorizontalAlignment="Center"
                               Grid.Row="2"
                               FontSize="24"
                               x:Name="totalStudentsText"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="2" 
              HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:ImageAwesome Icon="Book"
                             Foreground="{DynamicResource DefaultDarkGray}"
                             VerticalAlignment="Top"
                             Height="20" Width="20"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Total Classes"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultDarkGray}"/>
                    <TextBlock Text="0"
                               HorizontalAlignment="Center"
                               Grid.Row="2"
                               FontSize="24"
                               FontWeight="Bold"
                               x:Name="totalClassesText"
                               Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="4"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:ImageAwesome Icon="UserTimes"
                     Foreground="{DynamicResource DefaultDarkGray}"
                     VerticalAlignment="Top"
                     Height="20" Width="20"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Total Dropouts"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}"/>
                    <TextBlock Text="0"
                               HorizontalAlignment="Center"
                               Grid.Row="2"
                               FontSize="24"
                               x:Name="totalDropText"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
