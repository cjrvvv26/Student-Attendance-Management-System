<UserControl x:Class="Student_Attendance_Management_System.Teacher.Components.ListOfUnreadMessages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Student_Attendance_Management_System.Teacher.Components" xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:ListOfUnreadMessages}"
            d:DesignHeight="359" d:DesignWidth="300" >
    <ItemsControl ItemsSource="{Binding NotificationList}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border CornerRadius="5"
            Padding="5"
            MouseLeftButtonDown="notifBorder_MouseLeftButtonDown"
            Tag="{Binding}"
            x:Name="notifBorder">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <!--Profile-->
                        <Border CornerRadius="3" Height="30" Width="30"
                    x:Name="defaultProfileBorder"
                    Background="{DynamicResource DefaultLightGray}">
                            <fa:ImageAwesome Icon="User"
                     Width="20" Height="20"
                     Foreground="{DynamicResource DefaultGray}"/>
                        </Border>
                        <!--Message Details-->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}"
                               FontSize="12"
                               x:Name="titleText"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DefaultPrimary}"/>
                                <TextBlock Grid.Column="2" Foreground="{DynamicResource DefaultGray}"
                               x:Name="Role"
                               FontWeight="Bold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0 2"
                               FontSize="10">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="[ {0} ]">
                                            <Binding Path="Triggered_by" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="{Binding Message}"
                           Foreground="{DynamicResource DefaultGray}"
                           x:Name="messageText"
                           FontSize="12"
                           Grid.Row="2"
                           FontWeight="Medium"/>
                        </Grid>
                        <!--Message action-->
                        <Button Grid.Column="4" Template="{DynamicResource RemovePrimaryTrigger}"
                    Click="trashBtn_Click"
                    Tag="{Binding}"
                    x:Name="trashBtn"
                    Height="35" Width="35"
                    Background="#FB2C36">
                            <fa:ImageAwesome Icon="Trash" x:Name="trashIcon" Foreground="White" Height="18"
                   Width="18"/>
                        </Button>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Value="Read">
                        <Setter TargetName="titleText" Property="Foreground" Value="{DynamicResource DefaultGray}" />
                    </DataTrigger>
                    <Trigger SourceName="notifBorder" Property="IsMouseOver" Value="True">
                        <Setter TargetName="notifBorder" Property="Background" Value="{DynamicResource DefaultPrimary}" />
                        <Setter TargetName="titleText" Property="Foreground" Value="White"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter TargetName="Role" Property="Foreground" Value="White"/>
                        <Setter TargetName="messageText" Property="Foreground" Value="White"/>
                        <Setter TargetName="defaultProfileBorder" Property="Background" Value="White"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
