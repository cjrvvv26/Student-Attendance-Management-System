<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Components.SubjectTrash"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Components" xmlns:fa="http://schemas.fontawesome.io/icons/" 
      xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" d:DataContext="{d:DesignInstance Type=local:DisplayTrashSubjects}"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="760"
      Title="SubjectTrash">

    <Grid Background="White">
        <DataGrid Style="{DynamicResource DefaultDataGrid}"
              ItemsSource="{Binding TrashSubjects}"
              CellStyle="{DynamicResource DefaultDataGridCellStyle}"
              RowStyle="{DynamicResource LastestRowStyle}"
              ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Subject Code" Width="100" Binding="{Binding Subject_code}"/>
                <DataGridTextColumn Header="Subject Name" Width="*" Binding="{Binding Subject_name}" />
                <DataGridTextColumn Header="Semester" Width="*" Binding="{Binding Subject_semester}" />
                <DataGridTextColumn Header="Course" Width="*" Binding="{Binding Course_availability}" />
                <DataGridTextColumn Header="Year &amp; Section" Width="*" Binding="{Binding Year_section}" />
                <DataGridTemplateColumn Header="Operations" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Button Click="RestoreSubject_Click" Height="45" 
                                    Padding="15 0"         
                                    Template="{DynamicResource RemovePrimaryTrigger}"
                                    Background="#00C951"
                                    Tag="{Binding}">
                                    <fa:ImageAwesome Icon="ClockOutline" Width="20"
                                                 Height="20"
                                                 Foreground="White"/>
                                </Button>
                                <Button Click="DeleteSubject_Click" Height="45" 
                                    Padding="15 0"    
                                    Grid.Column="2"
                                    Template="{DynamicResource RemovePrimaryTrigger}"
                                    Background="#FB2C36"
                                    Tag="{Binding}">

                                    <fa:ImageAwesome Icon="Trash" Width="20"
                                                 Height="20"
                                                 Foreground="White"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
