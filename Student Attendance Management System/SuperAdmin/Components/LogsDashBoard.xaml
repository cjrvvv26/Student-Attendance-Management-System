<UserControl x:Class="Student_Attendance_Management_System.SuperAdmin.Components.LogsDashBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Components"
             xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" 
             d:DataContext="{d:DesignInstance Type=viewmodel:AuditLogsVM}"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1000">
    <DataGrid RowStyle="{DynamicResource DefaultLogRow}" 
          Style="{DynamicResource DefaultDataGrid}"
          x:Name="recordLogs"
          Grid.Row="1"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Hidden"
          
          ItemsSource="{Binding Logs}"
          CellStyle="{DynamicResource DefaultDataGridCellStyle}"
          ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}">
        <DataGrid.Columns>
            <DataGridTextColumn Header="User No." Width="*" Binding="{Binding User_no}"/>
            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding User_name}"/>
            <DataGridTextColumn Header="Role" Width="*" Binding="{Binding Role}"/>
            <DataGridTextColumn Header="Affected Entity" Width="*" Binding="{Binding Affected_entity}"/>
            <DataGridTextColumn Header="Action" Width="*" Binding="{Binding Action}"/>
            <DataGridTextColumn Header="Action Type" Width="*" Binding="{Binding Action_type}"/>
            <DataGridTextColumn Header="Timestamp" Width="*" Binding="{Binding Created_at}"/>
            <DataGridTextColumn Header="Status" Width="*" Binding="{Binding Status}"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
