<UserControl x:Class="Student_Attendance_Management_System.SuperAdmin.Components.OverallSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Components" xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="108.5" d:DesignWidth="1040">
    <!--Top Report Summary-->
    <Border CornerRadius="10"
            Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:ImageAwesome Icon="Users"
                     Foreground="{DynamicResource DefaultDarkGray}"
                     VerticalAlignment="Top"
                     Height="20" Width="20"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Total Students"
                   FontSize="15"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultDarkGray}"/>
                    <TextBlock Text="0"
                   Grid.Row="2"
                               x:Name="totalStudents"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:ImageAwesome Icon="IdCard"
                     Foreground="{DynamicResource DefaultDarkGray}"
                     VerticalAlignment="Top"
                     Height="20" Width="20"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Total Teachers"
                   FontSize="15"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultDarkGray}"/>
                    <TextBlock Text="0"
                   Grid.Row="2"
                               x:Name="totalTeachers"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:ImageAwesome Icon="Book"
                     Foreground="{DynamicResource DefaultDarkGray}"
                     VerticalAlignment="Top"
                     Height="20" Width="20"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Total Classes"
                   FontSize="15"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultDarkGray}"/>
                    <TextBlock Text="0"
                   Grid.Row="2"
                               x:Name="totalClasses"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:ImageAwesome Icon="UserTimes"
                                 Foreground="{DynamicResource DefaultDarkGray}"
                                 VerticalAlignment="Top"
                                 Height="20" Width="20"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Total Dropouts"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}"/>
                    <TextBlock Text="0"
                               x:Name="totalDrop"
                               Grid.Row="2"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
