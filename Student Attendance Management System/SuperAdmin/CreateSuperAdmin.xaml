<Window x:Class="Student_Attendance_Management_System.SuperAdmin.CreateSuperAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin" xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="514">
    <Border CornerRadius="20" Background="White">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Create Admin Account" Foreground="{DynamicResource DefaultPrimary}" FontSize="25" FontWeight="Bold"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Width="180" FontSize="13" FontWeight="Medium" Foreground="{StaticResource DefaultGray}" Text="First Name"/>
                    <TextBox Grid.Row="2" Height="35" 
                             FontSize="13"
                             Padding="5 0"
                             Width="182.5"
                             x:Name="fname"
                             VerticalContentAlignment="Center"
                             FontWeight="Medium"
                             Foreground="{DynamicResource DefaultDarkGray}"
                             Template="{DynamicResource TextBoxInput}"
                             Background="White"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Width="180" FontSize="13" FontWeight="Medium" Foreground="{StaticResource DefaultGray}" Text="Last Name"/>
                    <TextBox Grid.Row="2" Height="35" 
                             FontSize="13"
                             Width="182.5"
                             x:Name="lname"
                             Padding="5 0"
                             VerticalContentAlignment="Center"
                             FontWeight="Medium"
                             Foreground="{DynamicResource DefaultDarkGray}"
                             Template="{DynamicResource TextBoxInput}"
                             Background="White"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource DefaultGray}" Text="Email"/>
                <TextBox Grid.Row="2" Height="35" 
                         FontSize="13"
                         FontWeight="Medium"
                             x:Name="email"
                             Padding="5 0"
                             VerticalContentAlignment="Center"
                         Width="375"
                         Foreground="{DynamicResource DefaultDarkGray}"
                         Template="{DynamicResource TextBoxInput}"
                         Background="White"/>
            </Grid>
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource DefaultGray}" Text="Password"/>
                <Grid Grid.Row="2">
                    <PasswordBox Height="35"
                             Width="375"
                             VerticalContentAlignment="Center"
                             Padding="5 0 40 0"
                             x:Name="password"
                             FontSize="13"
                             FontWeight="Medium"
                             Foreground="{DynamicResource DefaultDarkGray}"
                                 Style="{DynamicResource DefaultPasswordBoxTemplate}"
                             Background="White"/>

                    <Button x:Name="showPassBtn"
                            Background="Transparent"
                            Width="20"
                            Height="20"
                            Template="{DynamicResource RemovePrimaryTrigger}" Margin="345,10,10,7">
                        <fa:ImageAwesome Icon="EyeSlash" 
                                        VerticalAlignment="Center"
                                        Height="10" Width="15" 
                                        Foreground="{DynamicResource DefaultPrimary}"/>
                    </Button>
                </Grid>
            </Grid>
            <Grid Grid.Row="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource DefaultGray}" Text="Confirm Password"/>
                <Grid Grid.Row="2">
                    <PasswordBox Height="35" 
                                 Style="{DynamicResource DefaultPasswordBoxTemplate}"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Padding="5 0 40 0"
                             Width="375"
                             x:Name="passwordConfirm"
                             FontWeight="Medium"
                             Foreground="{DynamicResource DefaultDarkGray}"
                             Background="White"/>

                    <Button x:Name="showPassAgainBtn"
                            Background="Transparent"
                            Width="20"
                            Height="20"
                            Template="{DynamicResource RemovePrimaryTrigger}" Margin="345,10,10,7">
                        <fa:ImageAwesome Icon="EyeSlash"  
                                    VerticalAlignment="Center"
                                    Height="10" Width="15" 
                                    Foreground="{DynamicResource DefaultPrimary}"/>
                    </Button>
                </Grid>
            </Grid>
            <Grid Grid.Row="10">
                <Button HorizontalContentAlignment="Center"
                        Padding="0 10"
                        Click="SignUpSA_Click"
                        VerticalContentAlignment="Center"
                        Template="{DynamicResource RemovePrimaryTrigger}"
                        Background="{DynamicResource DefaultPrimary}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="User"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Height="15" Width="15" />
                        <TextBlock Text="Create Account"
                                   FontSize="13"
                                   Grid.Column="2"
                                   FontWeight="Medium"
                                   Foreground="White" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
