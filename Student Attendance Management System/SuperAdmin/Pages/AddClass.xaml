<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.AddClass"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      mc:Ignorable="d" 
      xmlns:fa="http://schemas.fontawesome.io/icons/" d:DataContext="{d:DesignInstance Type=local:AvailableTeachersVM}"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="AddClass">

    <Grid Background="White" Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        
        <!--Top Ribbon-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Template="{DynamicResource TopRibbonGray}"
                    FontSize="12"
                    Foreground="{DynamicResource DefaultGray}"
                    FontWeight="Medium"
                    Background="Transparent"
                    Content="All Class" RenderTransformOrigin="0.71,0.68" />
            <fa:ImageAwesome Grid.Column="2" 
                             Icon="ChevronRight" 
                             Width="8" Height="8"
                             Foreground="{DynamicResource DefaultGray}"/>
            <Button Template="{DynamicResource TopRibbonGray}" 
                    Grid.Column="4"
                    FontSize="12"
                    Foreground="{DynamicResource DefaultPrimary}"
                    FontWeight="Medium"
                    Background="Transparent"
                    Content="Add Class" />
        </Grid>

        <ScrollViewer Grid.Row="2">
            <!--Add Class Content-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <!--Course & Section Selection-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Course &amp; Section Information"
                   FontSize="15"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultPrimary}" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}"
                           Text="Course" />
                            <ComboBox x:Name="courseCombo"
                          Grid.Row="1"
                          VerticalContentAlignment="Center"
                          Padding="15 10"
                          FontSize="14"
                          Background="{DynamicResource DefaultLightGray}"
                          Foreground="{DynamicResource DefaultDarkGray}"
                          FontWeight="Medium"
                          Template="{DynamicResource InputComboBox}"
                          SelectionChanged="courseCombo_SelectionChanged" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}"
                           Text="Year &amp; Section" />
                            <ComboBox x:Name="sectionCombo"
                          Grid.Row="1"
                          VerticalContentAlignment="Center"
                          Padding="15 10"
                          FontSize="14"
                          Background="{DynamicResource DefaultLightGray}"
                          Foreground="{DynamicResource DefaultDarkGray}"
                          FontWeight="Medium"
                          Template="{DynamicResource InputComboBox}"
                          SelectionChanged="sectionCombo_SelectionChanged" />
                        </Grid>
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}"
                           Text="Class Semester" />
                            <ComboBox x:Name="semesterCombo"
                          Grid.Row="1"
                          VerticalContentAlignment="Center"
                          Padding="15 10"
                          FontSize="14"
                          Background="{DynamicResource DefaultLightGray}"
                          Foreground="{DynamicResource DefaultDarkGray}"
                          FontWeight="Medium"
                          Template="{DynamicResource InputComboBox}"
                          SelectionChanged="semesterCombo_SelectionChanged" />
                        </Grid>

                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultGray}"
                                       Text="Class Term" />
                            <ComboBox x:Name="termCombo"
                                      Grid.Row="1"
                                      VerticalContentAlignment="Center"
                                      Padding="15 10"
                                      FontSize="14"
                                      Background="{DynamicResource DefaultLightGray}"
                                      Foreground="{DynamicResource DefaultDarkGray}"
                                      FontWeight="Medium"
                                      Template="{DynamicResource InputComboBox}" />
                        </Grid>
                    </Grid>
                </Grid>
                <!--Subject Information-->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subject Information"
                   FontSize="15"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultPrimary}" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}"
                           Text="Select Subject" />
                            <ComboBox x:Name="subjectCombo"
                            Grid.Row="1"
                            VerticalContentAlignment="Center"
                            Padding="15 10"
                            FontSize="14"
                            Background="{DynamicResource DefaultLightGray}"
                            Foreground="{DynamicResource DefaultDarkGray}"
                            FontWeight="Medium"
                            Template="{DynamicResource InputComboBox}"
                            SelectionChanged="subjectCombo_SelectionChanged" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}"
                           Text="Subject Code" />
                            <TextBlock 
                                x:Name="subjectCodeText"
                                FontWeight="Medium"
                                Grid.Row="1"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Padding="5 10"
                                Foreground="{DynamicResource DefaultDarkGray}"/>
                        </Grid>
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}"
                           Text="Subject Unit" />
                            <TextBlock 
                                x:Name="subjectUnitText"
                                FontWeight="Medium"
                                Grid.Row="1"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Padding="5 10"
                                Foreground="{DynamicResource DefaultDarkGray}" />
                        </Grid>
                    </Grid>
                </Grid>
                <!--Select Schedule-->
                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Select Class Schedule"
                   FontSize="15"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultPrimary}" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}"
                           Text="Select Day" />
                            <ComboBox x:Name="scheduleDayCombo"
                                      Grid.Row="1"
                                      VerticalContentAlignment="Center"
                                      Padding="15 10"
                                      FontSize="14"
                                      Background="{DynamicResource DefaultLightGray}"
                                      Foreground="{DynamicResource DefaultDarkGray}"
                                      FontWeight="Medium"
                                      Template="{DynamicResource InputComboBox}"
                                      SelectionChanged="scheduleDayCombo_SelectionChanged" />
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultGray}"
                                       Text="Select Time" />
                            <ComboBox x:Name="scheduleTimeSelect"
                                      Grid.Row="1"
                                      VerticalContentAlignment="Center"
                                      Padding="15 10"
                                      FontSize="14"
                                      Background="{DynamicResource DefaultLightGray}"
                                      Foreground="{DynamicResource DefaultDarkGray}"
                                      FontWeight="Medium"
                                      Template="{DynamicResource InputComboBox}"
                                      SelectionChanged="scheduleTimeSelect_SelectionChanged" />
                            
                        </Grid>
                    </Grid>
                </Grid>
                <!--Teacher Information-->
                <Grid Grid.Row="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Select Available Teacher"
                   FontSize="15"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultPrimary}" />
                    <Grid Grid.Row="2" MinHeight="200"  
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                        <DataGrid Style="{DynamicResource DefaultDataGrid}"
                                  RowStyle="{DynamicResource DefaultLogRow}"
                                  ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}"
                                  x:Name="dataGridTeachers"
                                  FontSize="13"
                                  ItemsSource="{Binding AvailableTeachers}"
                                    AutoGenerateColumns="False"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  CellStyle="{DynamicResource DefaultDataGridCellStyle}" SelectionMode="Single" SelectionChanged="dataGridTeachers_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn x:Name="rowCheckBox" Header="Select" Width="Auto" Binding="{Binding IsSelected, Mode=TwoWay}">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}" />
                                    </DataGridCheckBoxColumn.ElementStyle>
                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}" />
                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="Professor No."
                                        Width="*" 
                                        Binding="{Binding Employee_number}"/>
                                <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Full_name}"/>
                                <DataGridTextColumn Header="Age" Width="*" Binding="{Binding Age}"/>
                                <DataGridTextColumn Header="Gender" Width="*" Binding="{Binding Gender}"/>
                                <DataGridTextColumn Header="Department" Width="*" Binding="{Binding Department}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2"
                                   Text="Select Course &amp; Section First"
                                   FontSize="13"
                                   x:Name="noCourseSectionText"
                                   FontWeight="Medium"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource DefaultGray}" />
                        <TextBlock Grid.Row="2"
                                    Text="No Teacher Available"
                                    FontSize="13"
                                   Visibility="Collapsed"
                                    x:Name="noTeacherAvailableText"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource DefaultGray}" />
                    </Grid>
                </Grid>
                <Button FontSize="13"
                        HorizontalAlignment="Left"
                        Grid.Row="10"
                        Padding="15 0"
                        x:Name="addClassBtn"
                        IsEnabled="False"
                        Click="AddClass_Click"
                        Height="50"
                        Background="{DynamicResource DefaultPrimary}"
                        Template="{DynamicResource RemovePrimaryTrigger}" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Plus" Width="15" Height="15"
                             Foreground="White" />
                        <TextBlock Text="Add Class"
                       Grid.Column="2"
                       Foreground="White" />
                    </Grid>
                </Button>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
