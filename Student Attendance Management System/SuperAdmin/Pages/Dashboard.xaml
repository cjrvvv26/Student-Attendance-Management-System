<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      xmlns:chart="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Components" xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="Dashboard">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Hidden">
        <Grid  Margin="20 10 20 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--Top Report Summary-->
            <chart:OverallSummary />

            <!--Mid Section-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <!--Overall Monthly Attendance Status-->
                <Border CornerRadius="10"
            Background="White"
            
                        Height="350" >
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
                    </Border.Effect>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Gender Attendance Status"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource DefaultDarkGray}"/>
                        <!--  -->
                        <Grid Grid.Row="2">
                            <chart:ClassStatusLineGraph />
                        </Grid>
                    </Grid>
                </Border>
                <!--Notifications-->
                <Border CornerRadius="10" 
                        Grid.Column="2"
                        Background="white" 
                        Height="350" 
                        Width="300">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
                    </Border.Effect>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Notifications"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultDarkGray}"
                                       />
                            <Button Content="View more"
                                    Click="ViewMoreNotification_Click"
                                    Background="Transparent"
                                    Foreground="{DynamicResource DefaultGray}"
                                    Template="{DynamicResource TopRibbonGray}"
                                    Grid.Column="2"
                                    FontSize="12"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden" Grid.Row="2">
                            <Grid x:Name="notifBox" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <!--Bottom Section-->
            <Border Grid.Row="4" Padding="20" CornerRadius="10"  Background="White" Height="500">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" Opacity="0.15" ShadowDepth="0" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Audit logs"
                                   Foreground="{DynamicResource DefaultDarkGray}"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   />
                        <Button Content="View more"
                                Click="ViewMoreLogs_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource DefaultGray}"
                                Template="{DynamicResource TopRibbonGray}"
                                Grid.Column="2"
                                FontSize="12"/>
                    </Grid>

                    <ScrollViewer
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="auto"
                        Grid.Row="2">
                        <chart:LogsDashBoard />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
