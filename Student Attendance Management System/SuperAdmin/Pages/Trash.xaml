<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.Trash"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Trash">

    <Grid Background="White" Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Height="50"
                      Background="Transparent"
                      Template="{DynamicResource InputComboBox}"
                      Padding="15 0"
                      SelectionChanged="typeArchiveFilter_SelectionChanged"
                      x:Name="typeArchiveFilter"
                      VerticalContentAlignment="Center"
                      Foreground="{DynamicResource DefaultDarkGray}" />
        </Grid>
        <!--Content-->
        <Frame NavigationUIVisibility="Hidden"
               x:Name="trashTable"
               Grid.Row="2"/>
    </Grid>
</Page>
