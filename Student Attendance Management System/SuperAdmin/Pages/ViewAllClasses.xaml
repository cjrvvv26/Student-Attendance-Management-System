<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.ViewAllClasses"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:ClassesVM}"
      mc:Ignorable="d" 
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="ViewAllClasses">

    <Grid Margin="20 10 20 20" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Button Foreground="White"
                        Background="{DynamicResource DefaultPrimary}"
                        Template="{DynamicResource RemovePrimaryTrigger}"
                        Padding="15 0"
                        Height="50"
                        Click="AddClass_Click"
                        FontSize="13"
                        FontWeight="Medium">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="plus" Height="10"
                             Width="10" Foreground="White"/>
                        <TextBlock Grid.Column="2"
                                     VerticalAlignment="Center"
                                     Margin="5 0 0 0"
                                     FontSize="13"
                                     FontWeight="Medium"
                                     Foreground="White"
                                     Text="Add Class"/>
                    </Grid>
                </Button>

                <Button Foreground="White"
                        Background="#FB2C36"
                        Template="{DynamicResource RemovePrimaryTrigger}"
                        Padding="15 0"
                        x:Name="DeleteSelectedClassIcon"
                        Height="50"
                        Click="DeleteSelectedClassIcon_Click"
                        FontSize="13"
                        Grid.Column="2"
                        FontWeight="Medium">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <fa:ImageAwesome Icon="Trash" Height="20"
                            Width="20" Foreground="White"/>

                        <TextBlock FontSize="13"
                                   Grid.Column="2"
                                   FontWeight="Medium"
                                   Foreground="White"
                                   Text="Delete All" />
                    </Grid>
                </Button>
            </Grid>
            <Grid Grid.Column="2" x:Name="FilterSection">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="courseFilterCombo"
                          FontSize="13"
                          SelectionChanged="courseFilterCombo_SelectionChanged"
                          FontWeight="Medium"
                          Foreground="{DynamicResource DefaultDarkGray}"
                          Background="{DynamicResource DefaultLightGray}"
                          Template="{DynamicResource InputComboBox}"
                          VerticalContentAlignment="Center"
                          Padding="15 10" />

                <ComboBox x:Name="yearSectionFilterCombo"
                          FontSize="13"
                          Grid.Column="2"
                          FontWeight="Medium"
                          SelectionChanged="yearSectionFilterCombo_SelectionChanged"
                          Foreground="{DynamicResource DefaultDarkGray}"
                          Background="{DynamicResource DefaultLightGray}"
                          Template="{DynamicResource InputComboBox}"
                          VerticalContentAlignment="Center"
                          Padding="15 10" />

                <ComboBox x:Name="semesterFilterCombo"
                          FontSize="13"
                          Grid.Column="4"
                          SelectionChanged="semesterFilterCombo_SelectionChanged"
                          FontWeight="Medium"
                          Foreground="{DynamicResource DefaultDarkGray}"
                          Background="{DynamicResource DefaultLightGray}"
                          Template="{DynamicResource InputComboBox}"
                          VerticalContentAlignment="Center"
                          Padding="15 10" />
            </Grid>
        </Grid>
        <!--Content-->
        <DataGrid Grid.Row="2"
                  x:Name="dataViewAllClass"
                  Style="{DynamicResource DefaultDataGrid}"
                  ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}"
                  RowStyle="{DynamicResource LastestRowStyle}"
                  CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                  ItemsSource="{Binding trashClasses}"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Class ID" Width="100" Binding="{Binding Class_id}"/>
                <DataGridTextColumn Header="Proffesor/Instructor" Width="*" Binding="{Binding Teacher_name}"/>
                <DataGridTextColumn Header="Subject" Width="*" Binding="{Binding Subject_name}"/>
                <DataGridTextColumn Header="Course" Width="*" Binding="{Binding Course}"/>
                <DataGridTextColumn Header="Year &amp; Section" Width="*" Binding="{Binding Year_section}"/>
                <DataGridTextColumn Header="Semester" Width="*" Binding="{Binding Class_semester}"/>
                <DataGridTextColumn Header="Day" Width="*" Binding="{Binding Schedule_day}"/>
                <DataGridTextColumn Header="Time" Width="*" Binding="{Binding Schedule_time}"/>
                <DataGridTemplateColumn Header="Operations">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Button Click="ViewClassInfo_Click" Height="45" 
                                        Padding="15 0"         
                                        Template="{DynamicResource RemovePrimaryTrigger}"
                                        Background="#00C951"
                                        Tag="{Binding}">
                                    <fa:ImageAwesome Icon="Eye" Width="20"
                                                     Height="20"
                                                     Foreground="White"/>
                                </Button>
                                <Button Click="DeleteClass_Click" Height="45" 
                                        Padding="15 0"    
                                        Grid.Column="2"
                                        Template="{DynamicResource RemovePrimaryTrigger}"
                                        Background="#FB2C36"
                                        Tag="{Binding}">

                                    <fa:ImageAwesome Icon="Trash" Width="20"
                                                     Height="20"
                                                     Foreground="White"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid x:Name="displayErrorBox"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Grid.Row="2" >
            <TextBlock x:Name="errorTextBlock"
                       FontSize="14"
                       Margin="0 0 0 250"
                       Text="No Class Data"
                       FontWeight="Medium"
                       Foreground="{DynamicResource DefaultGray}"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Page>
