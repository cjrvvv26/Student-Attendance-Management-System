<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.ViewSubjects"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages" xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" xmlns:fa="http://schemas.fontawesome.io/icons/" d:DataContext="{d:DesignInstance Type=viewmodel:SubjectVM}"
      mc:Ignorable="d" 
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="ViewSubjects">

    <Grid Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Template="{DynamicResource RemovePrimaryTrigger}"
                    FontSize="13"
                    Height="50"
                    Padding="15 0"
                    Foreground="White"
                    FontWeight="Medium"
                    Content="Add Subject"
                    Click="AddSubject_Click"
                    Background="{DynamicResource DefaultPrimary}" />
        </Grid>
        <!--Content-->
        <DataGrid x:Name="SubjectDataGrid" RowStyle="{DynamicResource LastestRowStyle}" Grid.Row="2"
                  ItemsSource="{Binding Subjects}"
                  Style="{DynamicResource DefaultDataGrid}"
                  CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                  ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Subject Code"
                                    Width="auto"
                                    Binding="{Binding Subject_code}"/>
                <DataGridTextColumn Header="Subject Name"
                                    Width="*"
                                    Binding="{Binding Subject_name}"/>
                <DataGridTextColumn Header="Units"
                                    Width="*"
                                    Binding="{Binding Units}"/>
                <DataGridTextColumn Header="Course"
                                    Width="*"
                                    Binding="{Binding Course_availability}"/>
                <DataGridTextColumn Header="Year &amp; Section"
                                    Width="*"
                                    Binding="{Binding Year_availability}"/>
                <DataGridTemplateColumn Header="Operations" Width="*">
                    <!--Action Buttons-->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Button Click="ViewSubjectInfo_Click" Height="45" 
                                        Padding="15 0"         
                                        Template="{DynamicResource RemovePrimaryTrigger}"
                                        Background="#00C951"
                                        Tag="{Binding}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Icon="AddressCard" Width="20"
                                                         Height="20"
                                                         Foreground="White"/>
                                        <TextBlock Text="View"
                                                   VerticalAlignment="Center"
                                                   Grid.Column="2"
                                                   FontWeight="Medium"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                    </Grid>
                                </Button>
                                <Button Click="DeleteSubject_Click" Height="45" 
                                        Padding="15 0"    
                                        Grid.Column="2"
                                        Template="{DynamicResource RemovePrimaryTrigger}"
                                        Background="#FB2C36"
                                        Tag="{Binding}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Icon="Trash" Width="20"
                                                         Height="20"
                                                         Foreground="White"/>
                                        <TextBlock Text="Delete"
                                                   VerticalAlignment="Center"
                                                   Grid.Column="2"
                                                   FontWeight="Medium"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="No Subject Data" 
                   Foreground="{DynamicResource DefaultGray}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 250"
                   FontSize="14"
                   FontWeight="Medium"
                   x:Name="noSubjectDisplay"
                   Visibility="Collapsed"
                   Grid.Row="2"/>
    </Grid>
</Page>
