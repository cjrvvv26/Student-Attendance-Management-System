<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      mc:Ignorable="d" 
      xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:AdminVM}"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="Profile">

    <Grid Background="White" Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid VerticalAlignment="Center" Margin="0 0 0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center" x:Name="topRibbonBox" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Button Template="{DynamicResource TopRibbonGray}"
                        FontSize="12"
                        Foreground="{DynamicResource DefaultGray}"
                        FontWeight="Medium"
                        Background="Transparent"
                        Content="Your Information" Click="ViewInfo_Click"/>
                <fa:ImageAwesome Grid.Column="2" Icon="ChevronRight"
                                 Width="8" Height="8"
                                 Foreground="{DynamicResource DefaultGray}"/>
                <Button Template="{DynamicResource TopRibbonGray}" 
                        Grid.Column="4"
                        FontSize="12"
                        Foreground="{DynamicResource DefaultPrimary}"
                        FontWeight="Medium"
                        x:Name="updateInfoTopRibbon"
                        Background="Transparent"
                        Content="Update Information" />
            </Grid>
            <Button Grid.Column="2" Template="{DynamicResource RemovePrimaryTrigger}"
                    Background="Transparent"
                    x:Name="pencilUpdateIcon"
                    Click="UpdateMode_Click">
                <fa:ImageAwesome Icon="Pencil" Width="20" Height="20" Foreground="{DynamicResource DefaultGray}" />
            </Button>
        </Grid>
        <!--Content-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="User ID:"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}" />
                <TextBlock Text="{Binding AdminData.User_id}"
                           FontSize="13"
                           Grid.Column="2"
                           FontWeight="Medium"
                           Foreground="{DynamicResource DefaultGray}" />
            </Grid>
            <!--sec row-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="First Name" />
                    <TextBlock FontSize="14"
                               FontWeight="Medium"
                               Grid.Row="1"
                               x:Name="fnameText"
                               Padding="5 10"
                               Foreground="{DynamicResource DefaultDarkGray}"
                               Text="{Binding AdminData.First_name}" />
                    <TextBox x:Name="fnameBox"
                             Padding="5 10"
                             Template="{DynamicResource TextBoxInput}"
                             Grid.Row="1"
                             Visibility="Collapsed"
                             Foreground="{DynamicResource DefaultDarkGray}"
                             Background="White"
                             FontSize="14"
                             FontWeight="Medium" />
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="Last Name" />
                    <TextBlock FontSize="14"
                               FontWeight="Medium"
                               Grid.Row="1"
                               x:Name="lnameText"
                               Padding="5 10"
                               Foreground="{DynamicResource DefaultDarkGray}"
                               Text="{Binding AdminData.Last_name}" />
                    <TextBox x:Name="lnameBox"
                             Padding="5 10"
                             Grid.Row="1"
                             Template="{DynamicResource TextBoxInput}"
                             Visibility="Collapsed"
                             Foreground="{DynamicResource DefaultDarkGray}"
                             Background="White"
                             FontSize="14"
                             FontWeight="Medium" />
                </Grid>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="Role" />
                    <TextBlock FontSize="14"
                               FontWeight="Medium"
                               Grid.Row="1"
                               Padding="5 10"
                               Foreground="{DynamicResource DefaultDarkGray}"
                               Text="{Binding AdminData.Role}" />
                </Grid>
            </Grid>
            <!--third row-->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="Email" />
                    <TextBlock FontSize="14"
                               FontWeight="Medium"
                               Grid.Row="1"
                               x:Name="emailText"
                               Padding="5 10"
                               Foreground="{DynamicResource DefaultDarkGray}"
                               Text="{Binding AdminData.Email}" />
                    <TextBox x:Name="emailBox"
                             Padding="5 10"
                             Grid.Row="1"
                             Template="{DynamicResource TextBoxInput}"
                             Visibility="Collapsed"
                             Foreground="{DynamicResource DefaultDarkGray}"
                             Background="White"
                             FontSize="14"
                             FontWeight="Medium" />
                </Grid>
                <Grid Grid.Column="2" x:Name="oldPassBox" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="Old Password" />
                    <TextBox x:Name="passwordTextBox"
                            Padding="5 10 50 0"
                            Grid.Row="1"
                            Style="{DynamicResource TextBoxLatestInput}"
                            Background="White"
                            FontSize="14"
                             Visibility="Collapsed"
                            FontWeight="Medium" />
                    <PasswordBox x:Name="passwordBox"
                                 Padding="5 10 50 0"
                                 Grid.Row="1"
                                 Style="{DynamicResource DefaultPasswordBoxTemplate}"
                                 Background="White"
                                 FontSize="14"
                                 FontWeight="Medium" />
                    <Button Background="Transparent"
                            Grid.Row="1"
                            x:Name="hideOldPass"
                            Width="30"
                            Height="25"
                            Click="ShowOldPass_Click"
                            Template="{DynamicResource RemovePrimaryTrigger}" Margin="300,8,10,8"
                            >
                        <fa:ImageAwesome Icon="EyeSlash" x:Name="OldPassIcon" Foreground="{DynamicResource DefaultPrimary}" Height="25" Width="25" />
                    </Button>
                </Grid>
                <Grid Grid.Column="4" x:Name="newPassBox" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="New Password" />
                    <TextBox x:Name="newPasswordTextBox"
                            Padding="5 10 50 0"
                            Grid.Row="1"
                            Style="{DynamicResource TextBoxLatestInput}"
                            Background="White"
                            FontSize="14"
                             Visibility="Collapsed"
                            FontWeight="Medium" />
                    <PasswordBox x:Name="newPasswordBox"
                                 Padding="5 10 50 0"
                                 Grid.Row="1"
                                 Style="{DynamicResource DefaultPasswordBoxTemplate}"
                                 Background="White"
                                 FontSize="14"
                                 FontWeight="Medium" />
                    <Button Background="Transparent"
                            Grid.Row="1"
                            Width="30"
                            x:Name="hideNewPass"
                            Height="25"
                            Click="HideNewPass_Click"
                            Template="{DynamicResource RemovePrimaryTrigger}" Margin="300,8,10,8"
                            >   
                        <fa:ImageAwesome Icon="EyeSlash" x:Name="NewPassIcon" Foreground="{DynamicResource DefaultPrimary}" Height="25" Width="25" />
                    </Button>
                </Grid>
            </Grid>
            <!--4th row-->
            <Grid Grid.Row="6" x:Name="updateBtnsBox" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="proceedUpdateBtn"
                        FontSize="13"
                        Foreground="White"
                        FontWeight="Medium"
                        Height="50"
                        Padding="15 0"
                        Click="ProceedUpdateBtn_Click"
                        Content="Update Information"
                        Background="{DynamicResource DefaultPrimary}"
                        Template="{DynamicResource RemovePrimaryTrigger}" />
                <Button x:Name="cancelUpdateBtn"
                        FontSize="13"
                        Foreground="{DynamicResource DefaultGray}"
                        FontWeight="Medium"
                        Height="50"
                        Grid.Column="2"
                        Padding="15 0"
                        Click="CancelUpdateBtn_Click"
                        Content="Cancel"
                        Background="Transparent"
                        Template="{DynamicResource RemovePrimaryTrigger}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
