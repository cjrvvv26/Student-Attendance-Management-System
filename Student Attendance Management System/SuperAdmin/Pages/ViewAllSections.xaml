<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.ViewAllSections"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages" xmlns:fa="http://schemas.fontawesome.io/icons/" 
      xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:SectionVM}"
      mc:Ignorable="d" 
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="ViewAllSections">

    <Grid Background="White" Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Background="{DynamicResource DefaultPrimary}"
                    Template="{DynamicResource RemovePrimaryTrigger}"
                    Foreground="White"
                    Padding="15 0"
                    Height="50"
                    Click="AddSection_Click"
                    FontSize="13"
                    FontWeight="Medium"
                    Content="Add Course &amp; Section" />
            <ComboBox x:Name="courseFilterCombo" 
                      Grid.Column="2"
                      SelectionChanged="courseFilterCombo_SelectionChanged"
                      Padding="15 0"
                      VerticalContentAlignment="Center"
                      Template="{DynamicResource InputComboBox}"/>
        </Grid>
        <DataGrid Grid.Row="2"
                  x:Name="allSectionDataGrid"
                  ItemsSource="{Binding Sections}"
                  Style="{DynamicResource DefaultDataGrid}"
                  RowStyle="{DynamicResource LastestRowStyle}"
                  ColumnHeaderStyle="{DynamicResource DefaultDataGridColumnHeaderStyle}"
                  CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Course ID"
                                    Width="*"
                                    Binding="{Binding Section_id}"/>
                <DataGridTextColumn Header="Course"
                    Width="*"
                    Binding="{Binding Course}"/>
                <DataGridTextColumn Header="Year Level"
                    Width="*"
                    Binding="{Binding Year_level}"/>
                <DataGridTextColumn Header="Section"
                                    Width="*"
                                    Binding="{Binding Section}"/>
                <DataGridTextColumn Header="Created At"
                    Width="*"
                    Binding="{Binding Created_at, StringFormat='{}{0:MM/dd/yyyy}'}"/>
                <DataGridTemplateColumn Header="Actions" Width="*">
                    <!--Action Buttons-->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Button Click="ViewSectionInfo_Click" Height="45" 
                                        Padding="15 0"         
                                        Template="{DynamicResource RemovePrimaryTrigger}"
                                        Background="#00C951"
                                        Tag="{Binding}">
                                <fa:ImageAwesome Icon="Eye" Width="20"
                                         Height="20"
                                         Foreground="White"/>
                                </Button>
                                <Button Click="DeleteSection_Click" Height="45" 
                                        Padding="15 0"    
                                        Grid.Column="2"
                                        Template="{DynamicResource RemovePrimaryTrigger}"
                                        Background="#FB2C36"
                                        Tag="{Binding}">

                                    <fa:ImageAwesome Icon="Trash" Width="20"
                                         Height="20"
                                         Foreground="White"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="noSectionDisplayText"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 250"
                   Grid.Row="2"
                   Visibility="Collapsed"
                   FontSize="14"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultGray}"
                   Text="No Year &amp; Section Data" />
    </Grid>
</Page>
