<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.AddSubject"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      mc:Ignorable="d" 
      xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:SubjectVM}"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="AddSubject">

    <Grid Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Template="{DynamicResource TopRibbonGray}"
                    FontSize="12"
                    Foreground="{DynamicResource DefaultGray}"
                    FontWeight="Medium"
                    Background="Transparent"
                    Content="View Subjects" Click="ViewSubject_Click"/>
            <fa:ImageAwesome Grid.Column="2" Icon="ChevronRight"  Width="8" Height="8"
             Foreground="{DynamicResource DefaultGray}"/>
            <Button Template="{DynamicResource TopRibbonGray}" 
                Grid.Column="4"
                FontSize="12"
                Foreground="{DynamicResource DefaultPrimary}"
                FontWeight="Medium"
                Background="Transparent"
                Content="Add Subject" />
        </Grid>
        <!--Add Subject Content-->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <!--1st Row-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subject Code"
                           Foreground="{DynamicResource DefaultGray}"
                           FontSize="13"
                           FontWeight="Medium"/>
                    <TextBox Template="{DynamicResource TextBoxInput}"
                         Padding="5 10"
                         Grid.Row="1"
                         TextWrapping="NoWrap"
                         FontSize="14"
                         Text="{Binding Subject_code, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subject Name"
                           Foreground="{DynamicResource DefaultGray}"
                           FontSize="13"
                           FontWeight="Medium"/>
                    <TextBox Template="{DynamicResource TextBoxInput}"
                         Padding="5 10"
                         Grid.Row="1"
                         TextWrapping="NoWrap"
                         FontSize="14"
                         Text="{Binding Subject_name, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subject Course Availability"
                           Foreground="{DynamicResource DefaultGray}"
                           FontSize="13"
                           FontWeight="Medium"/>
                    <ComboBox Template="{DynamicResource InputComboBox}"
                              Padding="5 10"
                              Grid.Row="1"
                              x:Name="courseAvailabilityCombo"
                              VerticalContentAlignment="Center"
                              SelectionChanged="courseAvailabilityCombo_SelectionChanged"
                              FontSize="14"
                              Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>
            <!--2nd Row-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Year Level Availability"
                               Foreground="{DynamicResource DefaultGray}"
                               FontSize="13"
                               FontWeight="Medium"/>
                    <ComboBox Template="{DynamicResource InputComboBox}"
                              Padding="5 10"
                              Grid.Row="1"
                              x:Name="yearCombo"
                              VerticalContentAlignment="Center"
                              FontSize="14"
                              Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subject Units"
                               Foreground="{DynamicResource DefaultGray}"
                               FontSize="13"
                               FontWeight="Medium"/>
                    <ComboBox Template="{DynamicResource InputComboBox}"
                              Padding="5 10"
                              Grid.Row="1"
                              x:Name="unitsCombo"
                              VerticalContentAlignment="Center"
                              FontSize="14"
                              Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subject Semester Availability"
                               Foreground="{DynamicResource DefaultGray}"
                               FontSize="13"
                               FontWeight="Medium"/>
                    <ComboBox Template="{DynamicResource InputComboBox}"
                              Padding="5 10"
                              Grid.Row="1"
                              x:Name="semesterCombo"
                              VerticalContentAlignment="Center"
                              FontSize="14"
                              Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
                
            </Grid>

            <Button Template="{DynamicResource RemovePrimaryTrigger}" 
                    Click="AddSubject_Click"
                    Grid.Row="4"
                    FontSize="12"
                    Height="50"
                    HorizontalAlignment="Left"
                    Padding="20 0"
                    Foreground="White"
                    FontWeight="Medium"
                    Background="{DynamicResource DefaultPrimary}"
                    Content="Add Subject" />
        </Grid>
    </Grid>
</Page>
