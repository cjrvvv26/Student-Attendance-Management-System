<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.AddTeacher"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      mc:Ignorable="d" 
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:TeacherVM}"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="AddTeacher">

    <Grid Background="White" Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Template="{DynamicResource TopRibbonGray}"
        FontSize="12"
        Foreground="{DynamicResource DefaultGray}"
        FontWeight="Medium"
        Background="Transparent"
        Content="Users" Click="Users_Click" RenderTransformOrigin="0.71,0.68" />
            <fa:ImageAwesome Grid.Column="2" Icon="ChevronRight"  Width="8" Height="8"
                 Foreground="{DynamicResource DefaultGray}"/>
            <Button Template="{DynamicResource TopRibbonGray}" 
        Grid.Column="4"
        FontSize="12"
        Foreground="{DynamicResource DefaultPrimary}"
        FontWeight="Medium"
        Background="Transparent"
        Content="Add teacher" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--Profile Pic-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <Rectangle x:Name="profileBox" Height="200" Width="200"
                    RadiusX="10" RadiusY="10">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="profileImg" Stretch="UniformToFill" ImageSource="https://plus.unsplash.com/premium_photo-1661942126259-fb08e7cce1e2?w=600&amp;auto=format&amp;fit=crop&amp;q=60&amp;ixlib=rb-4.0.3&amp;ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTN8fHRlYWNoZXIlMjBpbWFnZXxlbnwwfHwwfHx8MA%3D%3D"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Border x:Name="defaultProfileBox"
                        Visibility="Collapsed"
                        CornerRadius="10" Background="{DynamicResource DefaultLightGray}">
                    <fa:ImageAwesome Icon="User" Foreground="{DynamicResource DefaultGray}"
                                     Width="120" Height="120"/>
                </Border>
                <Button Grid.Row="2"
                 Template="{DynamicResource RemovePrimaryTrigger}"
                 Click="UploadImg_Click"
                 Background="{DynamicResource DefaultPrimary}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Image" Width="20" Height="20" Foreground="White"/>
                        <TextBlock Grid.Column="2" Text="Upload Profile" 
                    Foreground="White"
                    FontWeight="Medium"
                    FontSize="13"
                    />
                    </Grid>
                </Button>
            </Grid>
            <!--Right Content-->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden"
                  Grid.Column="2"
                  >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!--Basic Information-->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--Info Content-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <!--1st Row-->
                            <Grid>
                                <!--Info Col-->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="First Name"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultGray}"/>
                                    <TextBox x:Name="teacher_fname" 
                                     Template="{DynamicResource TextBoxInput}"
                                     Padding="5 10"
                                     Foreground="{DynamicResource DefaultDarkGray}"
                                     FontWeight="Medium"
                                     Background="{DynamicResource DefaultLightGray}"
                                     Grid.Row="1" FontSize="14"
                                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <!--2nd col-->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Middle Name"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultGray}"/>
                                    <TextBox x:Name="teacher_mname" 
                                     Template="{DynamicResource TextBoxInput}"
                                     Padding="5 10"
                                     Foreground="{DynamicResource DefaultDarkGray}"
                                     FontWeight="Medium"
                                     Background="{DynamicResource DefaultLightGray}"
                                     Grid.Row="1" FontSize="14"
                                     Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <!--3rd col-->
                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Last Name"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultGray}"/>
                                    <TextBox x:Name="teacher_lname" 
                                     Template="{DynamicResource TextBoxInput}"
                                     Padding="5 10"
                                     Foreground="{DynamicResource DefaultDarkGray}"
                                     FontWeight="Medium"
                                     Background="{DynamicResource DefaultLightGray}"
                                     Grid.Row="1" FontSize="14"
                                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </Grid>
                            <!--2nd Row-->
                            <Grid Grid.Row="2">
                                <!--Info Col-->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Gender"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultGray}"
                                       FontSize="13"/>
                                    <Grid Grid.Row="1"
                                  VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton GroupName="gender"
                                             FontWeight="Medium"
                                             VerticalContentAlignment="Center"
                                             Foreground="{DynamicResource DefaultDarkGray}"
                                             FontSize="14"
                                             x:Name="maleRadio"
                                             Checked="maleRadio_Checked"
                                             Content="Male" />
                                        <RadioButton 
                                            Grid.Column="1"
                                            FontSize="14"
                                            VerticalContentAlignment="Center"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource DefaultDarkGray}"
                                            x:Name="femaleRadio"
                                            Checked="femaleRadio_Checked"
                                            GroupName="gender" Content="Female" />
                                    </Grid>
                                </Grid>
                                <!--2nd col-->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Birth Date"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultGray}"/>
                                    <DatePicker Style="{DynamicResource InputDateTime}"                 
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource DefaultLightGray}"
                                        SelectedDate="{Binding Birth_date, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     FontWeight="Medium"
                                        Grid.Row="1">
                                        <DatePicker.Resources>
                                            <Style TargetType="Border" >
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                            <Style TargetType="DatePickerTextBox">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="IsReadOnly" Value="True"/>
                                            </Style>
                                        </DatePicker.Resources>
                                    </DatePicker>
                                </Grid>
                                <!--3rd col-->
                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="45" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Age"
                                       Foreground="{DynamicResource DefaultGray}"
                                       FontWeight="Medium"
                                       FontSize="13"/>
                                    <TextBlock Grid.Row="1" FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultDarkGray}"
                                       VerticalAlignment="Center" Text="{Binding Age, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </Grid>
                            <!--3rd Row-->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="45" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Email"
                                       Foreground="{DynamicResource DefaultGray}"
                                       FontSize="13"
                                               FontWeight="Medium"/>
                                    <TextBox Grid.Row="1"
                                     Template="{DynamicResource TextBoxInput}"
                                     Background="{DynamicResource DefaultLightGray}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     FontWeight="Medium"
                                     Padding="5 10"
                                     Foreground="{DynamicResource DefaultDarkGray}"
                                     FontSize="14"/>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Phone Number"
                                       FontSize="13"
                                               FontWeight="Medium"
                                       Foreground="{DynamicResource DefaultGray}"/>
                                    <TextBox Grid.Row="1"
                                     Template="{DynamicResource TextBoxInput}"
                                     Background="{DynamicResource DefaultLightGray}"
                                     Padding="5 10"
                                     FontWeight="Medium"
                                     FontSize="14"
                                     Foreground="{DynamicResource DefaultDarkGray}"
                                     Text="{Binding Phone_no,
                                     UpdateSourceTrigger=PropertyChanged}"
                                    />
                                </Grid>

                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="45" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Department"
                                       FontSize="13"
                                       Foreground="{DynamicResource DefaultGray}"
                                       FontWeight="Medium"/>
                                    <ComboBox x:Name="department_box"
                                      Template="{DynamicResource InputComboBox}"
                                      Padding="5 10"
                                      VerticalContentAlignment="Center"
                                      FontSize="14"
                                      FontWeight="Medium"
                                      Foreground="{DynamicResource DefaultDarkGray}"
                                      Grid.Row="1"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <!--Footer Row-->
                    <Button Grid.Row="6" Height="50" Margin="0 0 10 10" HorizontalAlignment="Right"
                            Padding="30 0"
                            FontSize="13"
                            FontWeight="Medium"
                            Template="{DynamicResource RemovePrimaryTrigger}"
                            Foreground="White"
                            Background="{DynamicResource DefaultPrimary}"
                            Click="AddTeacher_Click"
                            Content="Add Teacher" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
