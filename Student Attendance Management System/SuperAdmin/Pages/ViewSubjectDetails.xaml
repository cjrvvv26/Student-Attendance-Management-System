<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.ViewSubjectDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      mc:Ignorable="d" 
      xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:model="clr-namespace:Student_Attendance_Management_System.Models" d:DataContext="{d:DesignInstance Type=model:SubjectModel}"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="ViewSubjectDetails">

    <Grid Background="White" Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Template="{DynamicResource TopRibbonGray}"
                    FontSize="12"
                    Foreground="{DynamicResource DefaultGray}"
                    FontWeight="Medium"
                    Background="Transparent"
                    Content="View Subjects" Click="ViewSubjects_Click"/>
            <fa:ImageAwesome Grid.Column="2" Icon="ChevronRight"  Width="8" Height="8"
                             Foreground="{DynamicResource DefaultGray}"/>
            <Button Template="{DynamicResource TopRibbonGray}" 
                    Grid.Column="4"
                    FontSize="12"
                    Foreground="{DynamicResource DefaultPrimary}"
                    FontWeight="Medium"
                    Background="Transparent"
                    Content="Subject Information" />
        </Grid>
        <!--Content-->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="Subject Code" />
                    <TextBlock Grid.Row="1"
                               x:Name="subjectCodeText"
                               FontSize="14"
                               Padding="5 10"
                               Text="{Binding Subject_code}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                    <TextBox Grid.Row="1"
                               x:Name="subjectCodeBox"
                               Visibility="Collapsed"
                               FontSize="14"
                               Padding="5 10"
                               Template="{DynamicResource TextBoxInput}"
                               Text="{Binding Subject_code}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="Subject Name" />
                    <TextBlock Grid.Row="1"
                               FontSize="14"
                                 x:Name="subjectNameText"
                               Padding="5 10"
                               Text="{Binding Subject_name}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                    <TextBox   Grid.Row="1"
                               x:Name="subjectNameBox"
                               Visibility="Collapsed"
                               FontSize="14"
                               Padding="5 10"
                               Template="{DynamicResource TextBoxInput}"
                               Text="{Binding Subject_name}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                </Grid>

                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="Course Availability" />
                    <TextBlock Grid.Row="1"
                               FontSize="14"
                               Padding="5 10"
                                 x:Name="courseAvailabilityText"
                               Text="{Binding Course_availability}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                    <ComboBox  Grid.Row="1"
                               x:Name="courseAvailabilityBox"
                               Visibility="Collapsed"
                               SelectionChanged="courseAvailabilityBox_SelectionChanged"
                               FontSize="14"
                               Padding="5 10"
                               Template="{DynamicResource InputComboBox}"
                               Text="{Binding Course_availability}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultGray}"
                   Text="Year Level Availability" />
                    <TextBlock Grid.Row="1"
                               FontSize="14"
                               Padding="5 10"
                               x:Name="yearAvailabilityText"
                               Text="{Binding Year_availability}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                    <ComboBox  Grid.Row="1"
                               x:Name="yearAvailabilityBox"
                               Visibility="Collapsed"
                               FontSize="14"
                               Template="{DynamicResource InputComboBox}"
                               Padding="5 10"
                               Text="{Binding Year_availability}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                               Text="Subject Units" />
                    <TextBlock Grid.Row="1"
                               FontSize="14"
                               Padding="5 10"
                               x:Name="subjectUnitsText"
                               Text="{Binding Units}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                    <ComboBox  Grid.Row="1"
                               x:Name="subjectUnitsBox"
                               Visibility="Collapsed"
                               FontSize="14"
                               Padding="5 10"
                               Template="{DynamicResource InputComboBox}"
                               Text="{Binding Units}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                </Grid>

                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultGray}"
                   Text="Subject Semester Availability" />
                    <TextBlock Grid.Row="1"
                               FontSize="14"
                               x:Name="subjectSemesterText"
                               Padding="5 10"
                               Text="{Binding Subject_semester}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                    <ComboBox  Grid.Row="1"
                               x:Name="subjectSemesterBox"
                               Visibility="Collapsed"
                               FontSize="14"
                               Template="{DynamicResource InputComboBox}"
                               Padding="5 10"
                               Text="{Binding Subject_semester}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DefaultDarkGray}" />
                </Grid>
            </Grid>

            <Button Content="Update Subject"
                    Grid.Row="6"
                    HorizontalAlignment="Left"
                    Height="50"
                    x:Name="updateBtn"
                    Click="UpdateSubject_Click"
                    Foreground="White"
                    Background="{DynamicResource DefaultPrimary}"
                    FontSize="13"
                    FontWeight="Medium"
                    Template="{DynamicResource RemovePrimaryTrigger}"
                    Padding="20 10" />

            <Grid Grid.Row="6" x:Name="UpdateComponentBox" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Proceed Update"
                        HorizontalAlignment="Left"
                        Height="50"
                        x:Name="ProceedUpdate"
                        Click="ProceedUpdate_Click"
                        Foreground="White"
                        Background="{DynamicResource DefaultPrimary}"
                        FontSize="13"
                        FontWeight="Medium"
                        Template="{DynamicResource RemovePrimaryTrigger}"
                        Padding="20 10" />

                <Button Content="Cancel"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        Height="50"
                        x:Name="cancelBtn"
                        Click="cancelBtn_Click"
                        Foreground="{DynamicResource DefaultGray}"
                        Background="Transparent"
                        FontSize="13"
                        FontWeight="Medium"
                        Template="{DynamicResource RemovePrimaryTrigger}"
                        Padding="20 10" />
            </Grid>
        </Grid>
    </Grid>
</Page>
