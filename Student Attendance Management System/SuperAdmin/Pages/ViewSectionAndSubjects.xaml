<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.ViewSectionAndSubjects"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      mc:Ignorable="d" 
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="ViewSectionAndSubjects">

    <Grid Background="Transparent" Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--Top Ribbon-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>


                <Button Content="Add Section" Template="{DynamicResource RemovePrimaryTrigger}"
                        Foreground="White"
                        Background="{DynamicResource DefaultPrimary}"
                        Padding="15 0"
                        Height="50"
                        Click="AddSection_Click"
                        FontSize="13"
                        FontWeight="Medium"/>

                <Button Content="View Subjects" Template="{DynamicResource RemovePrimaryTrigger}"
                        Foreground="{DynamicResource DefaultGray}"
                        Background="Transparent"
                        Grid.Column="2"
                        Padding="15 0"
                        Height="50"
                        Click="ViewSubjects_Click"
                        FontSize="13"
                        FontWeight="Medium"/>
            </Grid>

            <ComboBox x:Name="courseFilterCombo" 
                      Grid.Column="2"
                      Padding="15 0"
                      VerticalContentAlignment="Center"
                      Template="{DynamicResource InputComboBox}"/>
        </Grid>

        <!--Add Section and Subject Content-->
        <!--Content-->
        <ScrollViewer VerticalScrollBarVisibility="Hidden"
              Grid.Row="2"
              HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Frame NavigationUIVisibility="Hidden"
               x:Name="SectionSubjectContent" />
                <TextBlock x:Name="noSubjectDisplayText"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 250"
                   Visibility="Collapsed"
                   FontSize="14"
                   FontWeight="Medium"
                   Foreground="{DynamicResource DefaultGray}"
                   Text="No data" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
