<Window x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.SuperAdminLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages" xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:AdminVM}"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Title="TeacherLayout" Height="720" Width="1280">

    <Border CornerRadius="10" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--Left Sec-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="PresenTrack" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <Grid Grid.Row="2" Margin="0 0 0 20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Button Click="Dashboard_Click" Content="Dashboard"/>
                    <Button Click="Profile_Click" Grid.Row="1" Content="Profile"/>
                    <Button Click="Class_Click" Grid.Row="2" Content="Class"/>
                    <Button Click="Sections_Click" Grid.Row="3" Content="Sections"/>
                    <Button Click="Subjects_Click" Grid.Row="4" Content="Subjects"/>
                    <Button Click="Users_Click" Grid.Row="5" Content="Users"/>
                    <Button Click="Notification_Click" Grid.Row="6" Content="Notification"/>
                    <Button Click="Reports_Click" Grid.Row="7" Content="Reports"/>
                    <Button Click="Audit_Logs_Click" Grid.Row="8" Content="Audit Logs"/>
                    <Button Click="Trash_Click" Grid.Row="9" Content="Trash"/>
                    <Button Click="Logout_Click" Grid.Row="12" Content="Logout"/>
                </Grid>
            </Grid>
            <!--Right Sec-->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--Header-->
                <Grid Margin="20 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding FullName}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="14" FontWeight="Bold" />
                        <TextBlock 
                            Grid.Row="1"
                            Foreground="{StaticResource GrayText}"
                            Text="{Binding Role}" FontSize="12" FontWeight="Medium" />
                    </Grid>
                </Grid>
                <Frame
                    Grid.Row="2"
                    x:Name="SAdminContent" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Border>
</Window>