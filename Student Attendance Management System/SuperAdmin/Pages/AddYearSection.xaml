<Page x:Class="Student_Attendance_Management_System.SuperAdmin.Pages.AddYearSection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Student_Attendance_Management_System.SuperAdmin.Pages"
      mc:Ignorable="d" 
      xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:viewmodel="clr-namespace:Student_Attendance_Management_System.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:SectionVM}"
      d:DesignHeight="590" d:DesignWidth="1080"
      Title="AddYearSection">

    <Grid Margin="20 10 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--Top Ribbon-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Template="{DynamicResource TopRibbonGray}"
                FontSize="12"
                Foreground="{DynamicResource DefaultGray}"
                FontWeight="Medium"
                Background="Transparent"
                Content="View Courses" Click="ViewCourses_Click" RenderTransformOrigin="0.71,0.68" />
            <fa:ImageAwesome Grid.Column="2" Icon="ChevronRight"  Width="8" Height="8"
             Foreground="{DynamicResource DefaultGray}"/>
            <Button Template="{DynamicResource TopRibbonGray}" 
                Grid.Column="4"
                FontSize="12"
                Foreground="{DynamicResource DefaultPrimary}"
                FontWeight="Medium"
                Background="Transparent"
                Content="Add Course &amp; Section" />
        </Grid>
        <!--Add Section Content-->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <!--1st Row-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Course"
                           Foreground="{DynamicResource DefaultGray}"
                           FontSize="13"
                           FontWeight="Medium"/>
                    <TextBox Template="{DynamicResource TextBoxInput}"
                             Padding="5 10"
                             Grid.Row="1"
                             TextWrapping="NoWrap"
                             x:Name="courseText"
                             FontSize="14"
                             Background="{DynamicResource DefaultLightGray}"
                             Text="{Binding Course}"
                             Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Year Level"
                           Foreground="{DynamicResource DefaultGray}"
                           FontSize="13"
                           FontWeight="Medium"/>
                    <TextBox Template="{DynamicResource TextBoxInput}"
                             Padding="5 10"
                             Grid.Row="1"
                             x:Name="yearText"
                             TextWrapping="NoWrap"
                             Background="{DynamicResource DefaultLightGray}"
                             FontSize="14"
                             Text="{Binding Year_level}"
                             Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Section"
                           Foreground="{DynamicResource DefaultGray}"
                           FontSize="13"
                           FontWeight="Medium"/>
                    <TextBox Template="{DynamicResource TextBoxInput}"
                             Padding="5 10"
                             Grid.Row="1"
                             x:Name="sectionText"
                             Background="{DynamicResource DefaultLightGray}"
                             TextWrapping="NoWrap"
                             FontSize="14"
                             Text="{Binding Section}"
                             Foreground="{DynamicResource DefaultDarkGray}"/>
                </Grid>
            </Grid>

            <Button Template="{DynamicResource RemovePrimaryTrigger}" 
                    Grid.Row="4"
                    FontSize="13"
                    Height="50"
                    HorizontalAlignment="Left"
                    Padding="20 0"
                    Click="AddCourseSection_Click"
                    Foreground="White"
                    FontWeight="Medium"
                    Background="{DynamicResource DefaultPrimary}"
                    Content="Add Course &amp; Section" />
        </Grid>
    </Grid>
</Page>
